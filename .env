####################################
# App URLs
#   API  → nginx :8000  (avoid 8080 — Dozzle)
#   UI   → frontend :7000
####################################

APP_NAME=Pulse
APP_ENV=production
APP_DEBUG=false
APP_URL=https://plapi.atrinadev.com
APP_KEY=base64:iyixkV8fRZMiz8O3WGcHlJcY4zHFdUU9OP5lLGyjbb0=
APP_TIMEZONE=Asia/Tehran

FRONTEND_URL=https://pulse.atrinadev.com
NEXT_PUBLIC_API_URL=https://plapi.atrinadev.com/api/v1

####################################
# PostgreSQL (infrastructure)
####################################

DB_CONNECTION=pgsql
DB_URL=postgresql://app_pulse:pulse%401234@postgres:5432/db_pulse

####################################
# Redis (infrastructure)
####################################

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
NOTIFICATION_QUEUE=notifications

####################################
# Misc
####################################

BROADCAST_CONNECTION=log
MAIL_MAILER=smtp
LOG_CHANNEL=stack
LOG_LEVEL=info

FCM_WEB_ICON=/icons/icon-192x192.png
FCM_DEFAULT_LINK="${FRONTEND_URL}"

SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
