####################################
# App URLs (point reverse-proxy here)
#   API  → nginx service :8000  (NOT 8080 — Dozzle uses 8080)
#   UI   → frontend service :7000
####################################

APP_NAME=Pulse
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.pulse.example.com
APP_KEY=
APP_TIMEZONE=Asia/Tehran

FRONTEND_URL=https://pulse.example.com
NEXT_PUBLIC_API_URL=https://api.pulse.example.com/api/v1

####################################
# PostgreSQL (infrastructure network)
# Laravel reads DB_URL (not DATABASE_URL) or DB_* vars
####################################

DB_CONNECTION=pgsql
DB_URL=postgresql://app_pulse:CHANGE_ME@postgres:5432/db_pulse
# Or split form:
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=db_pulse
# DB_USERNAME=app_pulse
# DB_PASSWORD=CHANGE_ME

####################################
# Redis (infrastructure network)
####################################

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
NOTIFICATION_QUEUE=notifications

####################################
# Misc
####################################

BROADCAST_CONNECTION=log
MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=info

FCM_WEB_ICON=/icons/icon-192x192.png
FCM_DEFAULT_LINK="${FRONTEND_URL}"

SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
